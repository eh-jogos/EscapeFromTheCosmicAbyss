code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 Start : source_color;
uniform vec4 End : source_color;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = Start;


// ColorParameter:4
	vec4 n_out4p0 = End;


// Input:5
	vec2 n_out5p0 = UV;


// VectorDecompose:6
	float n_out6p0 = vec3(n_out5p0, 0.0).x;
	float n_out6p1 = vec3(n_out5p0, 0.0).y;
	float n_out6p2 = vec3(n_out5p0, 0.0).z;


// Mix:2
	vec3 n_out2p0 = mix(vec3(n_out3p0.xyz), vec3(n_out4p0.xyz), vec3(n_out6p1));


// Output:0
	COLOR.rgb = n_out2p0;


}
