code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 transparency : source_color;
uniform vec4 base_color : source_color;
uniform float strength;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = transparency;


// ColorParameter:4
	vec4 n_out4p0 = base_color;


// Input:6
	vec2 n_out6p0 = UV;


// VectorDecompose:5
	float n_out5p0 = vec3(n_out6p0, 0.0).x;
	float n_out5p1 = vec3(n_out6p0, 0.0).y;
	float n_out5p2 = vec3(n_out6p0, 0.0).z;


// FloatParameter:7
	float n_out7p0 = strength;


// FloatOp:12
	float n_out12p0 = pow(n_out5p1, n_out7p0);


// Mix:10
	float n_in10p0 = 0.00000;
	float n_in10p1 = 1.00000;
	float n_out10p0 = mix(n_in10p0, n_in10p1, n_out12p0);


// Mix:2
	float n_out2p0 = mix(n_out3p0.x, n_out4p0.x, n_out10p0);


// FloatOp:11
	float n_in11p1 = 0.00000;
	float n_out11p0 = n_out10p0 * n_in11p1;


// Output:0
	COLOR.rgb = vec3(n_out2p0);
	COLOR.a = n_out11p0;


}
"
